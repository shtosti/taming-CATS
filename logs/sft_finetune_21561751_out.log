def calculate_ari(text):
    # Define the function to calculate ARI
    def calculate_ari(text):
        # Remove all non-alphanumeric characters
        text = ''.join(char for char in text if char.isalnum() or char.isspace())
        
        # Calculate the ARI
        words = text.split()
        num_words = len(words)
        total_words = sum(1 for word in words if word.isalpha())
        return (total_words / num_words) * 100

    # Calculate ARI
    text = calculate_ari(text)
    # Return the result
    return text

# Define the source text
