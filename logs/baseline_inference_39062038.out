Namespace(use_vllm=False, seed=37, model_path='meta-llama/Llama-3.2-1B-Instruct', model_name='meta-llama/Llama-3.2-1B-Instruct', dataset_name='Newsela_s', model_class='auto', model_family='base', max_length=4096, batch_size=16, slice_test=-1, output_file='output/baseline_inference/Llama-3.2-1B-Instruct-Newsela_s-CHAR_COMPRESSION/output_2.json', device='cuda', peft_path=None, control_tokens='data/prompts/control_tokens.json', system_prompts='data/prompts/system_prompts.json', user_prompts='data/prompts/user_prompts.json', metric_mapping='data/metric_mapping.json', metric_name='CHAR_COMPRESSION', user_prompt_id='token_explanation')

