or the highest blindfolded tightrope walk. </s>', 'system_prompt_id': 'sys_prompt_6', 'user_prompt_id': 'token_explanation', 'metric_name': 'FKGL', 'source_metric_value': 8.7, 'target_metric_value': 6.3, 'input_ids': [1, 1, 1587, 13, 1976, 460, 264, 10865, 7583, 297, 2245, 9878, 2500, 28723, 995, 8270, 264, 9878, 1799, 2751, 302, 272, 2245, 2787, 486, 272, 2188, 28723, 995, 9878, 1575, 272, 2245, 4771, 298, 272, 11382, 2078, 486, 272, 2188, 28723, 1684, 2261, 298, 9878, 1575, 264, 2245, 28725, 8270, 865, 272, 11939, 9878, 2500, 28725, 1671, 707, 4870, 7616, 28725, 8321, 442, 10928, 697, 28723, 2, 28705, 13, 1, 2188, 13, 775, 19199, 5324, 28747, 3563, 452, 1575, 272, 2296, 2245, 1259, 369, 871, 401, 867, 338, 28733, 28796, 1814, 3439, 27073, 16543, 325, 28765, 28796, 4727, 28731, 7420, 349, 10870, 6530, 298, 369, 6140, 297, 272, 2602, 6029, 710, 1693, 286, 298, 574, 7138, 9878, 2500, 28723, 415, 2602, 6029, 659, 272, 2296, 5032, 28747, 523, 1574, 2050, 1604, 28746, 10015, 13902, 415, 2602, 6029, 710, 1693, 286, 298, 272, 2832, 2245, 12825, 272, 401, 28796, 4727, 1192, 302, 272, 2832, 2245, 28723, 28705, 13, 17426, 25775, 28747, 523, 28765, 28796, 4727, 28746, 28783, 28723, 28787, 28767, 6523, 1604, 2377, 28762, 1040, 6274, 594, 6758, 356, 8575, 1432, 7729, 390, 11952, 9117, 9279, 808, 264, 1526, 2395, 297, 8449, 486, 7312, 356, 264, 6975, 311, 386, 438, 264, 28705, 28740, 28774, 28733, 27027, 1171, 473, 477, 27926, 3805, 28742, 28713, 7635, 15894, 298, 272, 19795, 13708, 2973, 14578, 28723, 1092, 739, 264, 875, 302, 28705, 28740, 28734, 362, 28733, 304, 28705, 28740, 28740, 362, 28733, 7844, 11049, 3567, 438, 382, 1126, 21352, 3658, 4556, 4228, 297, 8220, 1375, 28725, 15632, 28725, 2056, 264, 913, 438, 272, 5551, 28725, 590, 1539, 28742, 28707, 1709, 298, 967, 582, 28723, 415, 17492, 3125, 9262, 739, 11049, 8626, 23285, 17872, 6383, 3395, 272, 875, 767, 630, 4525, 298, 347, 264, 746, 15657, 28747, 2994, 1378, 575, 910, 272, 9117, 9279, 1918, 553, 13507, 272, 1171, 47